# Relink AI Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (gemini-3.5-flash-lite is recommended for fast multimodal reasoning)
GEMINI_MODEL=gemini-3.5-flash-lite

# Matching engine weights (must sum to 1.0)
WEIGHT_VISUAL=0.40
WEIGHT_TEXT=0.35
WEIGHT_GEO=0.25

# Threshold for high-confidence match alerts
MATCH_ALERT_THRESHOLD=0.65
